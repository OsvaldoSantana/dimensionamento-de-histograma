# Fim de linha LF no repositório; evita diferenças falsas entre Windows e GitHub.
* text=auto eol=lf
*.html text eol=lf diff=html
*.py   text eol=lf diff=python
*.md   text eol=lf diff=markdown
*.json text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.ps1  text eol=crlf
*.url  text eol=crlf
*.png  binary
*.jpg  binary
